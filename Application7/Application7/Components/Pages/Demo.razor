@page "/demo"

<div class="page-header">
    <h1><i class="bi bi-grid-fill"></i> UI Components Demo</h1>
    <p class="page-desc">See how both themes look on common UI elements.</p>
</div>

<!-- Buttons -->
<section class="demo-section">
    <h2 class="demo-section-title">Buttons</h2>
    <div class="demo-row">
        <button class="btn btn-primary"><i class="bi bi-check2"></i> Primary</button>
        <button class="btn btn-outline"><i class="bi bi-x"></i> Outline</button>
        <button class="btn btn-success"><i class="bi bi-check-circle"></i> Success</button>
        <button class="btn btn-danger"><i class="bi bi-exclamation-triangle"></i> Danger</button>
        <button class="btn btn-warn"><i class="bi bi-bell"></i> Warning</button>
    </div>
</section>

<!-- Cards -->
<section class="demo-section">
    <h2 class="demo-section-title">Cards</h2>
    <div class="demo-cards">
        <div class="demo-card">
            <div class="demo-card-icon" style="background:rgba(59,130,246,.12); color:#3b82f6">
                <i class="bi bi-envelope-fill"></i>
            </div>
            <h3>Messages</h3>
            <p>You have 3 unread messages waiting in your inbox.</p>
            <span class="demo-badge badge-blue">3 New</span>
        </div>
        <div class="demo-card">
            <div class="demo-card-icon" style="background:rgba(34,197,94,.12); color:#22c55e">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <h3>Tasks Done</h3>
            <p>All scheduled tasks completed successfully today.</p>
            <span class="demo-badge badge-green">Complete</span>
        </div>
        <div class="demo-card">
            <div class="demo-card-icon" style="background:rgba(245,158,11,.12); color:#f59e0b">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <h3>Warnings</h3>
            <p>Two system warnings require your attention soon.</p>
            <span class="demo-badge badge-orange">2 Alerts</span>
        </div>
    </div>
</section>

<!-- Form -->
<section class="demo-section">
    <h2 class="demo-section-title">Form Elements</h2>
    <div class="demo-form">
        <div class="form-group">
            <label>Full Name</label>
            <input type="text" class="form-input" placeholder="Enter your name" />
        </div>
        <div class="form-group">
            <label>Email Address</label>
            <input type="email" class="form-input" placeholder="you@example.com" />
        </div>
        <div class="form-group">
            <label>Category</label>
            <select class="form-input">
                <option>General</option>
                <option>Support</option>
                <option>Feedback</option>
            </select>
        </div>
        <div class="form-group">
            <label>Message</label>
            <textarea class="form-input" rows="3" placeholder="Write something..."></textarea>
        </div>
        <button class="btn btn-primary"><i class="bi bi-send-fill"></i> Submit</button>
    </div>
</section>

<!-- Alert Boxes -->
<section class="demo-section">
    <h2 class="demo-section-title">Alerts</h2>
    <div class="alert alert-info"><i class="bi bi-info-circle-fill"></i> This is an informational alert message.</div>
    <div class="alert alert-success"><i class="bi bi-check-circle-fill"></i> Operation completed successfully!</div>
    <div class="alert alert-warn"><i class="bi bi-exclamation-triangle-fill"></i> Please review before continuing.</div>
    <div class="alert alert-danger"><i class="bi bi-x-circle-fill"></i> An error occurred. Please try again.</div>
</section>
