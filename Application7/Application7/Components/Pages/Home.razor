@page "/"

<div class="page-hero">
    <div class="hero-badge">
        <i class="bi bi-stars"></i> Blazor Server App
    </div>
    <h1 class="hero-title">Light & Dark Mode</h1>
    <p class="hero-subtitle">
        Toggle between themes using the button in the top bar.
        Your preference is saved in <strong>localStorage</strong> and
        automatically restored on every page reload.
    </p>
    <div class="hero-actions">
        <a href="/demo" class="btn btn-primary">
            <i class="bi bi-grid-fill"></i> View Components
        </a>
        <a href="/about" class="btn btn-outline">
            <i class="bi bi-info-circle"></i> Learn More
        </a>
    </div>
</div>

<!-- How It Works -->
<section class="section">
    <h2 class="section-title"><i class="bi bi-gear-fill"></i> How It Works</h2>
    <div class="steps-grid">
        <div class="step-card">
            <div class="step-num">1</div>
            <div class="step-icon"><i class="bi bi-toggle-on"></i></div>
            <h3>Click Toggle</h3>
            <p>Press the toggle button or the "Switch to Dark/Light Mode" button in the top navbar.</p>
        </div>
        <div class="step-card">
            <div class="step-num">2</div>
            <div class="step-icon"><i class="bi bi-hdd-fill"></i></div>
            <h3>Saved Instantly</h3>
            <p>Your preference is immediately written to <code>localStorage</code> in the browser.</p>
        </div>
        <div class="step-card">
            <div class="step-num">3</div>
            <div class="step-icon"><i class="bi bi-arrow-clockwise"></i></div>
            <h3>Persists on Reload</h3>
            <p>On next visit, the theme is read from storage before the page even renders — no flash!</p>
        </div>
        <div class="step-card">
            <div class="step-num">4</div>
            <div class="step-icon"><i class="bi bi-palette2"></i></div>
            <h3>Full Page Theming</h3>
            <p>A CSS class on <code>&lt;body&gt;</code> controls all colors via CSS custom properties.</p>
        </div>
    </div>
</section>

<!-- Feature Cards -->
<section class="section">
    <h2 class="section-title"><i class="bi bi-lightning-fill"></i> Features</h2>
    <div class="feature-grid">
        <div class="feature-card accent-blue">
            <i class="bi bi-shield-check-fill"></i>
            <h3>No Flash on Load</h3>
            <p>Inline script applies theme before Blazor boots, preventing the white flash.</p>
        </div>
        <div class="feature-card accent-green">
            <i class="bi bi-arrow-repeat"></i>
            <h3>State Persists</h3>
            <p>LocalStorage keeps your choice across sessions, tabs, and page refreshes.</p>
        </div>
        <div class="feature-card accent-purple">
            <i class="bi bi-cpu-fill"></i>
            <h3>Blazor Server DI</h3>
            <p>Uses <code>IJSRuntime</code> for all localStorage operations cleanly via DI.</p>
        </div>
        <div class="feature-card accent-orange">
            <i class="bi bi-brush-fill"></i>
            <h3>CSS Variables</h3>
            <p>Entire theme is driven by CSS custom properties — no JavaScript style manipulation.</p>
        </div>
    </div>
</section>
