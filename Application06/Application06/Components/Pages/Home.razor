@page "/"
@rendermode InteractiveServer

<div class="home-page">
    <div class="hero">
        <div class="hero-icon">
            <i class="bi bi-bell-fill"></i>
        </div>
        <h1>Notification Service</h1>
        <p class="hero-sub">A configurable notification system built with Blazor &amp; Dependency Injection</p>

        <div class="hero-actions">
            <a href="/notifications" class="hero-btn btn-primary">
                <i class="bi bi-bell"></i> View Notifications
            </a>
            <a href="/settings" class="hero-btn btn-secondary">
                <i class="bi bi-sliders"></i> Configure Settings
            </a>
        </div>
    </div>

    <div class="features-grid">
        <div class="feature-card">
            <i class="bi bi-gear-fill" style="color:#4f8ef7"></i>
            <h3>Dependency Injection</h3>
            <p>NotificationConfig registered as singleton and injected into the service and components.</p>
        </div>
        <div class="feature-card">
            <i class="bi bi-layout-text-sidebar" style="color:#4fcf70"></i>
            <h3>Dynamic Views</h3>
            <p>Switch between Compact and Detailed notification styles on the fly.</p>
        </div>
        <div class="feature-card">
            <i class="bi bi-sliders" style="color:#a24ff7"></i>
            <h3>Live Configuration</h3>
            <p>Update count and style in settings — changes reflect instantly in the display page.</p>
        </div>
        <div class="feature-card">
            <i class="bi bi-lightning-fill" style="color:#f7a24f"></i>
            <h3>Async Service</h3>
            <p>GetNotificationsAsync() simulates a real async data-fetch with configurable count.</p>
        </div>
    </div>
</div>
