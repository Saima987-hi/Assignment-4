@page "/notifications"
@inject Application06.Services.NotificationService NotifService
@inject Application06.Models.NotificationConfig Config
@rendermode InteractiveServer

<div class="display-page">

    <!-- Toolbar -->
    <div class="display-toolbar">
        <div class="toolbar-left">
            <i class="bi bi-bell-fill toolbar-icon"></i>
            <div>
                <h2>Notifications</h2>
                <span class="subtitle">@_notifications.Count notification(s) loaded</span>
            </div>
        </div>
        <div class="toolbar-right">

            <!-- Style Toggle -->
            <div class="toggle-group">
                <button class="toggle-btn @(_currentStyle == "Compact" ? "tog-active" : "")"
                        @onclick='async () => await SetStyle("Compact")'>
                    <i class="bi bi-list-ul"></i> Compact
                </button>
                <button class="toggle-btn @(_currentStyle == "Detailed" ? "tog-active" : "")"
                        @onclick='async () => await SetStyle("Detailed")'>
                    <i class="bi bi-card-text"></i> Detailed
                </button>
            </div>

            <!-- Count Selector -->
            <select class="count-select" @onchange="OnCountChanged">
                @for (int i = 1; i <= 10; i++)
                {
                    var val = i;
                    <option value="@val" selected="@(val == _currentCount)">@val</option>
                }
            </select>

            <button class="btn-refresh" @onclick="LoadNotifications">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="stats-row">
        <div class="stat-chip chip-blue">
            <i class="bi bi-envelope-fill"></i>
            <span>@_notifications.Count(n => !n.IsRead) Unread</span>
        </div>
        <div class="stat-chip chip-green">
            <i class="bi bi-check-circle-fill"></i>
            <span>@_notifications.Count(n => n.IsRead) Read</span>
        </div>
        <div class="stat-chip chip-purple">
            <i class="bi bi-layout-text-sidebar"></i>
            <span>@_currentStyle View</span>
        </div>
    </div>

    <!-- Loading -->
    @if (_loading)
    {
        <div class="loading-container">
            <div class="spinner"></div>
            <p>Fetching notifications...</p>
        </div>
    }
    else if (!_notifications.Any())
    {
        <div class="empty-state">
            <i class="bi bi-bell-slash"></i>
            <p>No notifications found.</p>
        </div>
    }
    else
    {
        <div class="notification-list">
            @foreach (var n in _notifications)
            {
                @if (_currentStyle == "Compact")
                {
                    <!-- COMPACT VIEW -->
                    <div class="notif-compact @(n.IsRead ? "" : "unread")">
                        <div class="notif-dot" style="background:@n.BadgeColor"></div>
                        <div class="compact-icon" style="background:@(n.BadgeColor + "22")">
                            <i class="bi @n.IconClass" style="color:@n.BadgeColor"></i>
                        </div>
                        <div class="compact-body">
                            <span class="compact-title">@n.Title</span>
                            <span class="compact-msg">@TruncateMessage(n.Message, 60)</span>
                        </div>
                        <div class="compact-meta">
                            <span class="time-ago">@TimeAgo(n.Timestamp)</span>
                            @if (!n.IsRead)
                            {
                                <span class="badge-unread">New</span>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <!-- DETAILED VIEW -->
                    <div class="notif-detailed @(n.IsRead ? "" : "unread")">
                        <div class="detail-sidebar" style="background:@(n.BadgeColor + "18")">
                            <div class="detail-icon-wrap" style="background:@n.BadgeColor">
                                <i class="bi @n.IconClass"></i>
                            </div>
                            <span class="detail-category">@n.Category</span>
                        </div>
                        <div class="detail-body">
                            <div class="detail-header">
                                <span class="detail-title">@n.Title</span>
                                <div class="detail-badges">
                                    @if (!n.IsRead)
                                    {
                                        <span class="badge-unread">Unread</span>
                                    }
                                    else
                                    {
                                        <span class="badge-read">Read</span>
                                    }
                                    <span class="badge-cat" style="background:@(n.BadgeColor + "18"); color:@n.BadgeColor">@n.Category</span>
                                </div>
                            </div>
                            <p class="detail-msg">@n.Message</p>
                            <div class="detail-footer">
                                <i class="bi bi-clock"></i>
                                <span>@n.Timestamp.ToString("MMM dd, yyyy  hh:mm tt")</span>
                                <span class="time-sep">•</span>
                                <span>@TimeAgo(n.Timestamp)</span>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    private List<Application06.Models.Notification> _notifications = new();
    private string _currentStyle = "Compact";
    private int    _currentCount = 5;
    private bool   _loading      = false;

    protected override async Task OnInitializedAsync()
    {
        _currentStyle = Config.NotificationStyle;
        _currentCount = Config.DefaultNumberOfNotifications;
        await LoadNotifications();
    }

    private async Task LoadNotifications()
    {
        _loading = true;
        await Task.Delay(400);
        _notifications = await NotifService.GetNotificationsAsync(_currentCount);
        _loading = false;
    }

    private async Task SetStyle(string style)
    {
        _currentStyle = style;
        Config.NotificationStyle = style;
        await Task.CompletedTask;
    }

    private async Task OnCountChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            _currentCount = val;
            Config.DefaultNumberOfNotifications = val;
            await LoadNotifications();
        }
    }

    private string TruncateMessage(string msg, int maxLen)
        => msg.Length > maxLen ? msg[..maxLen] + "…" : msg;

    private string TimeAgo(DateTime dt)
    {
        var diff = DateTime.Now - dt;
        if (diff.TotalMinutes < 1)  return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours   < 24) return $"{(int)diff.TotalHours}h ago";
        return $"{(int)diff.TotalDays}d ago";
    }
}
