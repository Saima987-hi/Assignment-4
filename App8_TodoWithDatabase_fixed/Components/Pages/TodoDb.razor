@page "/todo-db"
@rendermode InteractiveServer
@inject App8_TodoWithDatabase.Services.TodoDbService DbService

<PageTitle>Todo with Database</PageTitle>
<h2>Application 8 – ToDo List with SQLite Database</h2>

<div style="max-width:600px">
    <div class="input-group mb-3">
        <input class="form-control" @bind="newTask" @bind:event="oninput" placeholder="Enter a new task..." />
        <button class="btn btn-primary" @onclick="AddTask" disabled="@string.IsNullOrWhiteSpace(newTask)">Add Task</button>
    </div>

    @if (editingId.HasValue)
    {
        <div class="card p-3 mb-3 border-warning">
            <label><b>Edit Task:</b></label>
            <input class="form-control" @bind="editText" />
            <div class="mt-2">
                <button class="btn btn-success btn-sm me-2" @onclick="SaveEdit">💾 Save</button>
                <button class="btn btn-secondary btn-sm" @onclick="CancelEdit">✕ Cancel</button>
            </div>
        </div>
    }

    @if (tasks.Count == 0)
    {
        <p class="text-muted">No tasks in database. Add one above!</p>
    }
    else
    {
        <ul class="list-group mb-3">
            @foreach (var item in tasks)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <input type="checkbox" @bind="item.IsCompleted" @bind:after="() => UpdateTask(item)" class="me-2" />
                        <span style="@(item.IsCompleted ? "text-decoration:line-through;color:gray" : "")">@item.Task</span>
                        <small class="text-muted ms-2">(@item.CreatedAt.ToString("MM/dd HH:mm"))</small>
                    </div>
                    <div>
                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => StartEdit(item)">✏️</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteTask(item.Id)">✕</button>
                    </div>
                </li>
            }
        </ul>
        <button class="btn btn-warning" @onclick="ClearAll">🗑 Clear All</button>
    }
</div>

@code {
    private List<App8_TodoWithDatabase.Models.TodoItem> tasks = new();
    private string newTask = string.Empty;
    private int? editingId = null;
    private string editText = string.Empty;

    protected override void OnInitialized()
    {
        LoadTasks();
    }

    private void LoadTasks() => tasks = DbService.GetAll();

    private void AddTask()
    {
        if (!string.IsNullOrWhiteSpace(newTask))
        {
            DbService.Add(newTask.Trim());
            newTask = string.Empty;
            LoadTasks();
        }
    }

    private void DeleteTask(int id)
    {
        DbService.Delete(id);
        LoadTasks();
    }

    private void UpdateTask(App8_TodoWithDatabase.Models.TodoItem item)
    {
        DbService.Update(item.Id, item.Task, item.IsCompleted);
        LoadTasks();
    }

    private void ClearAll()
    {
        DbService.DeleteAll();
        LoadTasks();
    }

    private void StartEdit(App8_TodoWithDatabase.Models.TodoItem item)
    {
        editingId = item.Id;
        editText = item.Task;
    }

    private void SaveEdit()
    {
        if (editingId.HasValue && !string.IsNullOrWhiteSpace(editText))
        {
            var item = tasks.First(t => t.Id == editingId.Value);
            DbService.Update(editingId.Value, editText.Trim(), item.IsCompleted);
            editingId = null;
            LoadTasks();
        }
    }

    private void CancelEdit() => editingId = null;
}
