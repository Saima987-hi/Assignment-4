@page "/"
@using Application3.Models
@rendermode InteractiveServer
<div class="mb-3">

    <label>Today task:</label><br />
    <input type="text" @bind="Tasks" placeholder="Enter your task name" required />
    <button @onclick="Add">Add Item</button>
    <button @onclick="Clear">Clear </button>
</div>
<div>
    <h3>View Tasks</h3>
    @if (tasklist.Count == 0)
    {
        <p>Task list is empty</p>
    }
    else
    {
        @foreach (var task in tasklist)
        {
            <ul>
                <li style="list-style:none; margin-bottom:5px">
                    <input type="checkbox" @bind="task.IsDone" />
                    <span style="@(task.IsDone ? " text-decoration: line-through; color=gray" : "")">
                        @task.Title
                    </span>
                </li>
            </ul>
        }
    }
</div>


@code {
    private string Tasks = "";
    private List<TodoItem> tasklist = new List<TodoItem>();


    void Add()
    {
        @if (Tasks != "")
        {
            tasklist.Add(new TodoItem { Title = Tasks, IsDone = false });
            Tasks = "";
        }
    }
    void Clear()
    {
        tasklist.Clear();
    }
}