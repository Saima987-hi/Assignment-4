@page "/"

@rendermode InteractiveServer
<h3>Counter</h3>
<div class="mb-3">
    <p>Currnet count: @count</p>
    <button class="btn btn-success" @onclick="AddCount">Click me</button>
</div>
<hr />
<div class="mb-3">
    <label>Manually adjust count:</label><br />
    <input type="number" @bind="count" class="form-control" style="width: 150px" />
</div>
@code {
    private int count = 0;

    void AddCount()
    {
        count++;
    }
}